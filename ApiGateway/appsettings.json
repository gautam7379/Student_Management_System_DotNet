{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "student-route": {
        "ClusterId": "student-cluster",
        "Match": {
          "Path": "/api/students/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Student/{**catch-all}"
          }
        ]
      },

      "teacher-route": {
        "ClusterId": "teacher-cluster",
        "Match": {
          "Path": "/api/teachers/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Teacher/{**catch-all}"
          }
        ]
      },

      "course-route": {
        "ClusterId": "course-cluster",
        "Match": {
          "Path": "/api/courses/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Course/{**catch-all}"
          }
        ]
      },

      "attendance-route": {
        "ClusterId": "attendance-cluster",
        "Match": {
          "Path": "/api/attendance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Attendance/{**catch-all}"
          }
        ]
      },

      "result-route": {
        "ClusterId": "result-cluster",
        "Match": {
          "Path": "/api/results/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Result/{**catch-all}"
          }
        ]
      },

      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Chat/{**catch-all}"
          }
        ]
      }


    },

    "Clusters": {
      "student-cluster": {
        "Destinations": {
          "student-service": {
            "Address": "http://localhost:5272/"
          }
        }
      },

      "teacher-cluster": {
        "Destinations": {
          "teacher-service": {
            "Address": "http://localhost:5028/"
          }
        }
      },

      "course-cluster": {
        "Destinations": {
          "course-service": {
            "Address": "http://localhost:5252/"
          }
        }
      },

      "attendance-cluster": {
        "Destinations": {
          "attendance-service": {
            "Address": "http://localhost:5189/"
          }
        }
      },

      "result-cluster": {
        "Destinations": {
          "result-service": {
            "Address": "http://localhost:5089/"
          }
        }
      },


      "chat-cluster": {
        "Destinations": {
          "chatbot-service": {
            "Address": "http://localhost:5099/"
          }
        }
      }
    }
  }
}